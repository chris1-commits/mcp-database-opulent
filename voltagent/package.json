{
  "name": "opulent-mcp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "VoltAgent AI agent with MCP integration for the Opulent MCP Gateway",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "workflow:ops": "tsx src/workflows/ops-check.ts",
    "workflow:lead": "tsx src/workflows/lead-ingest.ts",
    "workflow:security": "tsx src/workflows/webhook-validate.ts",
    "workflow:webhook-lead": "tsx src/workflows/webhook-to-lead.ts",
    "workflow:health-monitor": "tsx src/workflows/health-monitor.ts",
    "workflow:full-pipeline": "tsx src/workflows/full-pipeline.ts",
    "workflow:runner": "tsx src/workflows/automation-runner.ts",
    "check:elevenlabs": "node -e \"const p=JSON.parse(require('fs').readFileSync('./package-lock.json','utf8')); const deps=Object.keys(p.packages||{}); const bad=deps.filter(d=>d.includes('@elevenlabs/elevenlabs-js')); if(bad.length){console.error('Found @elevenlabs/elevenlabs-js as installed package:',bad); process.exit(1)} else {console.log('OK: no @elevenlabs/elevenlabs-js package installed')}\""
  },
  "overrides": {
    "elevenlabs": "1.59.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/openai": "latest",
    "@voltagent/core": "latest",
    "@voltagent/docs-mcp": "latest",
    "@voltagent/libsql": "latest",
    "@voltagent/logger": "latest",
    "@voltagent/sdk": "latest",
    "@voltagent/server-hono": "latest",
    "@voltagent/supabase": "latest",
    "@voltagent/voice": "latest",
    "@voltagent/xsai": "latest",
    "ai": "^6.0.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@voltagent/cli": "latest",
    "mcp-to-ai-sdk": "^0.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
