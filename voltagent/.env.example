# ── LLM Provider Keys ─────────────────────────────────────────────
# At least one provider key is required for the agent to function.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── MCP Gateway Connection ────────────────────────────────────────
# URL of the Opulent MCP Gateway RPC endpoint
MCP_GATEWAY_URL=http://localhost:8000/api/rpc
# Bearer token matching the gateway's MCP_AUTH_TOKEN
MCP_AUTH_TOKEN=your-mcp-auth-token-here

# ── VoltAgent Server ─────────────────────────────────────────────
# Port for the VoltAgent Hono server (VoltOps console connects here)
VOLTAGENT_PORT=3141

# ── Memory (LibSQL / Turso) ──────────────────────────────────────
# Local SQLite file or Turso remote URL for agent memory persistence
LIBSQL_URL=file:./voltagent-memory.db
# Turso auth token (only needed for remote Turso databases)
# LIBSQL_AUTH_TOKEN=

# ── Voice (optional) ─────────────────────────────────────────────
# OpenAI is used for voice by default; set provider keys above.
# For ElevenLabs voice, uncomment and set the following:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
